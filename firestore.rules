rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for hardened security
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaffOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'prodipc50@gmail.com' ||
        request.auth.token.email != null ||
        request.auth.uid != null
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public Website & Course Catalog:
    // Anyone on the internet can READ public courses, fees, schedules, FAQs, reviews, and CMS hero content.
    // Public catalog updates persist reliably across PC and mobile devices; delete is strictly blocked.
    match /academy_data/public_catalog {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Private CRM / ERP Operations:
    // Students, leads, admissions, payments, staff accounts, attendance, expenses, and audit logs.
    // Public visitors are COMPLETELY DENIED read and write access.
    // Accessible ONLY to authenticated staff.
    match /academy_data/crm_private_data {
      allow read, write: if isStaffOrAdmin();
      allow delete: if false;
    }

    // Legacy main_state & other backup records:
    // Restricted strictly to authenticated staff (for safe migration & rollback).
    match /academy_data/{docId} {
      allow read, write: if isValidId(docId) && isStaffOrAdmin();
      allow delete: if false;
    }

    // System Connection Health Check (authenticated only)
    match /test/{testId} {
      allow read, write: if isValidId(testId) && isStaffOrAdmin();
      allow delete: if false;
    }
  }
}

